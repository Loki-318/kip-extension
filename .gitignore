# Dependencies
node_modules/
.pnp
.pnp.js

# Build output
dist/
dist-ssr/
*.local
.crxjs/

# Extension packaging artifacts
*.crx
*.pem
*.zip

# Env / secrets — API keys live in chrome.storage.local via the Options
# page, never in a committed file, but keep this as a safety net in case
# a .env is ever introduced for local scripting/testing.
.env
.env.local
.env.*.local

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
logs/
*.log

